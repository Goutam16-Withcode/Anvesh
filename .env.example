# ==============================================================================
# ANVESH - AI-Powered Global Career Discovery & Recommendation Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=ANVESH
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend FastAPI Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Database (PostgreSQL 16)
POSTGRES_USER=anvesh_user
POSTGRES_PASSWORD=anvesh_secure_password
POSTGRES_DB=anvesh_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://anvesh_user:anvesh_secure_password@localhost:5432/anvesh_db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_JOB_COLLECTION=job_embeddings_v1
QDRANT_PROFILE_COLLECTION=profile_embeddings_v1
QDRANT_ROLE_COLLECTION=role_embeddings_v1

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Embedding & Transformer Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DEVICE=cuda

# LLM & AI Agent Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Job Ingestion & External APIs
JOB_INGESTION_BATCH_SIZE=100
JOB_FRESHNESS_TTL_DAYS=30
ALLOW_SCRAPING=False

# Next.js Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_TITLE=ANVESH Career Intelligence
